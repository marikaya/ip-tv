{
  "name": "deneme",
  "version": "1.0.0",
  "description": "Simple Electron-based IPTV player",
  "productName": "Deneme IPTV",
  "main": "src/main.js",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite",
    "dev:electron": "wait-on tcp:5173 && VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "build:renderer": "vite build",
    "start": "npm run build:renderer && electron .",
    "check": "npm run build:renderer && node --check src/main.js && node --check src/preload.js && node --check src/playlist.js && node --check src/epg.js",
    "package": "npm run build:renderer && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --dir --publish never",
    "release": "npm run build:renderer && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --publish never",
    "release:mac": "npm run build:renderer && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --publish never",
    "release:mac:signed": "npm run build:renderer && electron-builder --mac --publish never",
    "release:linux": "npm run build:renderer && electron-builder --linux --publish never",
    "release:win": "npm run build:renderer && electron-builder --win --publish never"
  },
  "keywords": [
    "electron",
    "iptv",
    "m3u"
  ],
  "author": "",
  "license": "MIT",
  "private": true,
  "type": "commonjs",
  "build": {
    "appId": "com.deneme.iptv",
    "productName": "Deneme IPTV",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/renderer/**/*",
      "src/**/*",
      "package.json",
      "build/icons/**/*",
      "!release{,/**/*}"
    ],
    "mac": {
      "icon": "build/icons/icon.icns",
      "category": "public.app-category.entertainment",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "linux": {
      "icon": "build/icons/icon.png",
      "category": "AudioVideo",
      "target": [
        "AppImage",
        "deb",
        "tar.gz"
      ]
    },
    "win": {
      "icon": "build/icons/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "electron": "^41.4.0",
    "electron-builder": "^26.8.1",
    "vite": "^8.0.10",
    "wait-on": "^9.0.5"
  },
  "dependencies": {
    "@ant-design/icons": "^6.2.2",
    "antd": "^6.3.7",
    "fast-xml-parser": "^5.7.2",
    "mpegts.js": "^1.8.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  }
}
